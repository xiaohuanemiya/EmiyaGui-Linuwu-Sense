[Unit]
Description=Predator PHN16-71 web control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/phnctl/phnctl.env
ExecStart=%h/.local/bin/phnctl serve
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
