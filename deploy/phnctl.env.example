# Bind to this machine's LAN address only. Using 0.0.0.0 also requires
# PHNCTL_ALLOW_ALL_INTERFACES=true.
PHNCTL_BIND=192.168.1.239:8443

PHNCTL_USERNAME=admin
PHNCTL_PASSWORD_HASH="pbkdf2-sha256$210000$REPLACE_WITH_GENERATED_SALT$REPLACE_WITH_GENERATED_HASH"
PHNCTL_SESSION_SECRET=REPLACE_WITH_BASE64_32_BYTE_SECRET

PHNCTL_TLS_CERT=/etc/phnctl/tls/cert.pem
PHNCTL_TLS_KEY=/etc/phnctl/tls/key.pem

PHNCTL_SYSFS_ROOT=/
PHNCTL_TELEMETRY_SECONDS=2

